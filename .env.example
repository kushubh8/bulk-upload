# Server Configuration
PORT=3000
NODE_ENV=development

# Rate Limiter Configuration
# Maximum number of tokens in the bucket (burst capacity)
RATE_LIMIT_TOKENS=10
# Tokens refilled per second
RATE_LIMIT_REFILL_RATE=5
# Maximum concurrent jobs being processed
MAX_CONCURRENCY=3

# File Upload Limits
# Maximum file size in bytes (default: 10MB)
MAX_FILE_SIZE_BYTES=10485760
# Allowed MIME types (comma-separated)
ALLOWED_MIME_TYPES=text/csv,application/vnd.ms-excel,application/csv

# Mock Employee Service Configuration
# Simulated failure rate (0.0 = never fail, 1.0 = always fail)
MOCK_FAILURE_RATE=0.1
# Simulated latency in milliseconds
MOCK_LATENCY_MS=50

# Logging
LOG_LEVEL=info
